# Variáveis da seção 18. Copie para .env.local e preencha. Nunca commite .env.local.
NEXT_PUBLIC_SITE_URL=http://localhost:3020
# Produção: https://reuniao.app.br
SUPABASE_URL=http://127.0.0.1:55421
SUPABASE_SERVICE_ROLE_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 32 bytes em base64: openssl rand -base64 32
TOKEN_ENC_KEY=
SESSION_SECRET=
CRON_SECRET=
# Lista separada por vírgula (seção 5)
EMAILS_PERMITIDOS=
# v0.5: vazia = cadastro aberto. Opcionais:
EMAILS_BLOQUEADOS=
CONTAS_NOVAS_POR_DIA=50
RESEND_API_KEY=
# Em dev, sem domínio verificado: onboarding@resend.dev (entrega só para o e-mail da conta Resend)
EMAIL_REMETENTE=onboarding@resend.dev
# Produção: agenda@reuniao.app.br (domínio verificado no Resend)
